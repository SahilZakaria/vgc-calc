{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@vgc/*": ["../src/*"],
      "@pkmn/mods/champions": ["node_modules/@pkmn/mods/build/champions/index.d.ts"]
    }
  },
  "include": ["src", "vite.config.ts", "championsDataPlugin.ts", "championsDataPlugin.test.ts"]
}
